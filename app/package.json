{
  "name": "finance-app-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Finance Tracker",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "turbo run build",
    "start": "concurrently \"pnpm --filter frontend start\" \"pnpm --filter backend start:prod\"",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "db:migrate:test": "dotenv -e .env.test pnpm --filter backend prisma migrate deploy",
    "prepare": "cd .. && husky app/.husky"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "concurrently": "^9.2.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@playwright/test": "^1.58.2",
    "husky": "^9.1.7",
    "turbo": "^2.8.9",
    "zod": "^3.22.3"
  }
}
