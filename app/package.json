{
  "name": "finance-app-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Finance Tracker",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "turbo run build",
    "start": "concurrently \"pnpm --filter frontend start\" \"pnpm --filter backend start:prod\"",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "db:migrate:test": "pnpm --filter backend exec dotenv run -f .env.test -- pnpm run db:migrate",
    "prepare": "cd .. && husky app/.husky"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "concurrently": "^10.0.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.65.1",
    "husky": "^9.1.7",
    "turbo": "^2.11.13",
    "zod": "^4.6.7"
  }
}
