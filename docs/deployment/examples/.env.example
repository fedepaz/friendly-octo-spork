# ──────────────────────────────────────────
# Production Environment Variables
# ──────────────────────────────────────────
# Copy this file to `.env` in the project root
# and fill in your actual values.
#
#   cp .env.example .env
#   docker compose up -d
# ──────────────────────────────────────────

# ── Nginx ──
NGINX_HOST_PORT=8081
SERVER_NAME=finance.midomain.com
FRONTEND_UPSTREAM=nextjs:3000
BACKEND_UPSTREAM=api:3001

# ── Database ──
POSTGRES_USER=user
POSTGRES_PASSWORD=CHANGE_ME

# ── Backend ──
BACKEND_NODE_ENV="production"
PORT="3001"
URL="https://finance.midomain.com"
CORS_ORIGINS="https://finance.midomain.com"

# Database — use service name in production
DATABASE_URL="postgresql://user:password@db:5432/finance-app"
DATABASE_HOST="db"
DATABASE_PORT="5432"
DATABASE_DATABASE_NAME="finance-app"
DATABASE_USER="user"
DATABASE_PASSWORD="CHANGE_ME"

# Generate with: openssl rand -hex 32
JWT_SECRET="CHANGE_ME_generate_with_openssl_rand_hex_32"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="CHANGE_ME_generate_with_openssl_rand_hex_32"
JWT_REFRESH_EXPIRES_IN="12h"
DEFAULT_PASSWORD=""

# ── Frontend (build args) ──
NEXT_PUBLIC_API_URL="https://finance.midomain.com/api"
