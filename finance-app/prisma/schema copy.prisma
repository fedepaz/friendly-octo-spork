// prisma/schema copy.prisma
// Personal Finance Tracker - Final Schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// MODELS
// ============================================

model User {
  id           String         @id @default(cuid())
  name         String
  passwordHash String
  email        String?        @unique
  
  transactions Transaction[]
  accounts     Account[]
  categories   Category[]
  recurrences  Recurrence[]
  
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Account {
  id       Int         @id @default(autoincrement())
  userId   String
  name     String
  type     AccountType
  currency Currency
  balance  Decimal     @default(0) @db.Decimal(15, 2)
  
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Transactions using this account
  transactionsFrom Transaction[] @relation("SourceAccount")
  transactionsTo   Transaction[] @relation("TargetAccount")
  
  // Recurrences using this account
  recurrencesFrom Recurrence[] @relation("RecurrenceSource")
  recurrencesTo   Recurrence[] @relation("RecurrenceTarget")
  
  @@index([userId])
}

model Category {
  id     Int     @id @default(autoincrement())
  userId String
  name   String
  color  String? // Hex color for UI
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  recurrences  Recurrence[]
  
  @@unique([userId, name])
  @@index([userId])
}

model Recurrence {
  id     Int             @id @default(autoincrement())
  userId String
  name   String          // "Gym Membership", "Car Payment", "Salary"
  type   TransactionType
  
  // Financial details
  amount    Decimal        @db.Decimal(15, 2)
  frequency RecurrenceType
  
  // Term tracking
  totalParts  Int? // NULL = infinite, N = fixed term
  currentPart Int  @default(0)
  
  // Date tracking
  startDate DateTime
  nextDate  DateTime
  endDate   DateTime? // Calculated: start + (totalParts * frequency)
  
  // Status
  active Boolean @default(true)
  
  // Categorization
  categoryId      Int?
  sourceAccountId Int? // For expenses: which account pays
  targetAccountId Int? // For income: which account receives
  
  // Card expenses (for card-based recurrences)
  isCardExpense Boolean  @default(false)
  cardType      CardType?
  
  // Metadata for additional info
  metadata Json?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sourceAccount Account?  @relation("RecurrenceSource", fields: [sourceAccountId], references: [id], onDelete: SetNull)
  targetAccount Account?  @relation("RecurrenceTarget", fields: [targetAccountId], references: [id], onDelete: SetNull)
  
  transactions Transaction[]
  
  @@index([userId, active])
  @@index([userId, type])
  @@index([nextDate])
}

model Transaction {
  id     Int             @id @default(autoincrement())
  userId String
  type   TransactionType
  amount Decimal         @db.Decimal(15, 2)
  date   DateTime
  
  // Optional description for specific details
  description String?
  
  // Link to recurrence (if this came from one)
  recurrenceId         Int?
  recurrencePartNumber Int? // Which payment of the recurrence (1/10, 2/10, etc.)
  
  // Categorization
  categoryId      Int?
  sourceAccountId Int?
  targetAccountId Int?
  
  // Budget tracking (for EXPENSE type)
  isBudgetedExpense Boolean?
  budgetCategory    BudgetCategory?
  
  // Card payment info (can be set on individual transactions)
  isCardExpense Boolean?
  cardType      CardType?
  
  // Income/Return source (for INCOME and RETURN types)
  source String? // "Mercado Pago Interest", "Salary - Company X"
  
  // Metadata for additional flexible data
  metadata Json?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurrence    Recurrence? @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  category      Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sourceAccount Account?    @relation("SourceAccount", fields: [sourceAccountId], references: [id], onDelete: SetNull)
  targetAccount Account?    @relation("TargetAccount", fields: [targetAccountId], references: [id], onDelete: SetNull)
  
  @@index([userId, date])
  @@index([userId, type])
  @@index([categoryId])
  @@index([recurrenceId])
}

// ============================================
// ENUMS
// ============================================

enum TransactionType {
  INCOME     // Money received (salary, freelance, gifts)
  EXPENSE    // Money spent (groceries, bills, purchases)
  TRANSFER   // Moving money between your accounts
  INVESTMENT // Buying investments (stocks, crypto)
  RETURN     // Investment returns, interest earned
  PAYMENT    // Debt payments, loan payments
}

enum AccountType {
  BANK       // Traditional bank account
  WALLET     // Crypto wallet
  CASH       // Physical cash
  CARD       // Credit/debit card
  INVESTMENT // Investment account
}

enum Currency {
  ARS  // Argentine Peso
  USD  // US Dollar
  USDT // Tether (stablecoin)
}

enum RecurrenceType {
  MONTHLY // Repeats every month
  WEEKLY  // Repeats every week
  YEARLY  // Repeats every year
}

enum BudgetCategory {
  DAILY_EXPENSES  // Day-to-day spending
  FOOD_GROCERIES  // Food and groceries
  ENTERTAINMENT   // Entertainment and leisure
  TRANSPORTATION  // Transport costs
  HEALTH          // Health and medical
  UTILITIES       // Bills and utilities
}

enum CardType {
  VISA
  MASTERCARD
  AMEX
  MAESTRO
}